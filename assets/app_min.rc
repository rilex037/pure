/* the lowest id is the file/exe icon: video. 2 = music (audio-only files) */
1 ICON "assets/video.ico"
2 ICON "assets/music.ico"
1 VERSIONINFO
FILEVERSION 1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Pure Player"
            VALUE "FileVersion", "1.0.2"
            VALUE "InternalName", "PurePlayer"
            VALUE "OriginalFilename", "PurePlayer.exe"
            VALUE "ProductName", "Pure Player"
            VALUE "ProductVersion", "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
