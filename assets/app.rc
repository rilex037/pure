#include <winver.h>

/* the lowest id is the file/exe icon: video. 2 = music (audio-only files) */
1 ICON "assets/video.ico"
2 ICON "assets/music.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Pure Player"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "PurePlayer"
            VALUE "OriginalFilename", "PurePlayer.exe"
            VALUE "ProductName", "Pure Player"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
